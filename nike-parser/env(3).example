# --- Required ---

# Nike style-color code (last part of the product URL)
STYLE_COLOR=IF2857-600

# Comma-separated Nike (US) sizes to watch, or "*" for all sizes
TARGET_SIZES=10,12.5

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123123123:AAAAAAA-VVVVVVVVVVVVVVVVVVVVVVVVVVV

# Chat ID to send notifications to (get it from @userinfobot,
# or via https://api.telegram.org/bot<token>/getUpdates after messaging your bot)
TELEGRAM_CHAT_ID=123456789

# --- Optional (defaults shown) ---

# Nike marketplace and language
MARKETPLACE=US
LANGUAGE=en

# How often to poll (Go duration: 5m, 300s, 1h). Keep >= 5m to avoid Akamai attention.
POLL_INTERVAL=10m

# Send a stock summary on the first successful poll (true/false)
NOTIFY_ON_START=true

# ── gr-ticket-bot configuration ─────────────────────────────────────────────
# Copy this file to ".env" and fill it in:  cp .env.example .env
# Everything the bot needs lives here.

# ── Telegram (required: token only) ──────────────────────────────────────────
# Create a bot: message @BotFather in Telegram -> /newbot -> copy the token.
# You do NOT need a chat id anymore: anyone who opens the bot and sends /start
# is subscribed and gets alerts. Each chat can /stop, /continue, and toggle the
# heartbeat independently. Subscribers are saved to SUBSCRIBERS_FILE.
TELEGRAM_BOT_TOKEN=111111111:VVVVVVV-AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: pre-subscribe one chat at startup (so you get the boot message before
# sending /start). Get it from https://api.telegram.org/bot<TOKEN>/getUpdates ->
# result[].message.chat.id. Leave empty to rely purely on /start.
TELEGRAM_CHAT_ID=12345566775

# Where the subscriber list is stored (created automatically).
SUBSCRIBERS_FILE=subscribers.json

# ── Which train to watch ─────────────────────────────────────────────────────
# Date is required. Give DEPARTURE_TIME and/or TRAIN_NUMBER so the bot knows
# exactly which departure to track (both = most precise).
DEPARTURE_DATE=2026-07-31
DEPARTURE_TIME=08:00      # LOCAL departure time from your origin, as HH:MM (N803 leaves Batumi 08:00)
TRAIN_NUMBER=803          # the "N803" train / rideNumber (empty = match by time only)

# ── Route + passengers ───────────────────────────────────────────────────────
# These are sent in the search request body. Defaults = Batumi -> Tbilisi.
START_STATION_CODE=57151
END_STATION_CODE=56014
PASSENGERS=1              # standard_passengers
CHILD_PASSENGERS=0
DISABLED_PASSENGERS=0
ROUTE_TYPE=0

# ── Polling behaviour ────────────────────────────────────────────────────────
CHECK_INTERVAL=5m         # how often to check (min 1m). "5m", "90s", or bare "5" = 5 minutes
ALERT_REPEAT=30m          # if seats stay available, re-alert at most this often
HEARTBEAT_EVERY=          # e.g. "6h" for a periodic "still alive" ping; empty = off

# ── Endpoint (works out of the box; override only if it changes) ─────────────
# The bot POSTs to this URL a JSON body built from the values above:
#   {"startStationCode":"...","endStationCode":"...","departureDateFrom":"...",
#    "standard_passengers":N,"child_passengers":N,"disabled_passengers":N,"routeType":N}
API_ENDPOINT=https://gr.com.ge/api/ticket-search

# ── Optional: only if the endpoint later needs auth (cookies/headers) ────────
# Capture the real request in Chrome DevTools (Network -> the ticket-search
# request -> right-click -> Copy as cURL), paste it into request.curl, and the
# bot will use it instead (still forcing your DEPARTURE_DATE into it).
API_CURL_FILE=request.curl
# Or specify pieces directly:
# API_URL=
# API_METHOD=POST
# API_BODY=
# API_HEADERS_JSON={"Cookie":"..."}

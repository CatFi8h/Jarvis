# ── Bot (shared) ────────────────────────────────────────────────────────────
# One Telegram bot token drives both parsers.
TELEGRAM_BOT_TOKEN=111111111:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Optional: bootstrap this chat as a subscriber to all parsers on startup.
# Normally you don't need this — chats subscribe themselves via /nike_start etc.
# TELEGRAM_CHAT_ID=123456789

# Where per-chat subscriptions are persisted.
SUBSCRIBERS_FILE=subscribers.json

# ── Nike parser ─────────────────────────────────────────────────────────────
# Watches a Nike product group and alerts when a target size restocks.
GROUP_KEY=GbnAW5Hb          # last path segment of the availability URL in DevTools
STYLE_COLOR=IF2857-600      # matched against productCode
TARGET_SIZES=10,10.5        # comma-separated labels, or "*" for all
MARKETPLACE=US
LANGUAGE=en
POLL_INTERVAL=10m
NOTIFY_ON_START=true

# ── GR (Georgian Railway) parser ────────────────────────────────────────────
# Watches gr.com.ge for free seats. Searches (route/date/train) are created from
# the bot with /gr_search — each chat can run several at once. They are
# persisted here so they survive restarts:
GR_SEARCHES_FILE=gr_searches.json
ROUTE_TYPE=0
PASSENGERS=1
CHILD_PASSENGERS=0
DISABLED_PASSENGERS=0
CHECK_INTERVAL=5m
ALERT_REPEAT=30m
HEARTBEAT_EVERY=0           # 0 = off, e.g. 6h for periodic "still alive" pings

# Optional overrides for the GR poll request (only if the default endpoint needs
# auth). Priority: API_CURL_FILE > API_URL/API_BODY > built-in default POST.
# API_CURL_FILE=request.curl
# API_URL=
# API_METHOD=
# API_BODY=
# API_HEADERS_JSON={"Cookie":"..."}
